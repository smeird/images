# Copy this file to .env and change local-only values as needed.
APP_HOST=127.0.0.1
APP_PORT=8080
ADMIN_ROUTE=/hidden-admin
SITE_NAME="Night Sky Atlas (local)"
MAX_UPLOAD_BYTES=157286400
UPLOAD_WATERMARK_TEXT="Smeird Astro"
UPLOAD_WATERMARK_ANCHOR=bottom-left
UPLOAD_WATERMARK_PADDING=16
# macOS Homebrew font example; leave blank to use the application's fallback.
UPLOAD_WATERMARK_FONT_PATH=
